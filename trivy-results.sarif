            {
              "id": "CVE-2025-65431",
              "name": "LanguageSpecificPackageVulnerability",
              "shortDescription": {
                "text": "An issue was discovered in allauth-django before 65.13.0. Both Okta an ..."
              },
              "fullDescription": {
                "text": "An issue was discovered in allauth-django before 65.13.0. Both Okta and NetIQ were using preferred_username as the identifier for third-party provider accounts. That value may be mutable and should therefore be avoided for authorization decisions. The providers are now using sub instead."
              },
              "defaultConfiguration": {
                "level": "warning"
              },
              "helpUri": "https://avd.aquasec.com/nvd/cve-2025-65431",
              "help": {
                "text": "Vulnerability CVE-2025-65431\nSeverity: MEDIUM\nPackage: django-allauth\nFixed Version: 65.13.0\nLink: [CVE-2025-65431](https://avd.aquasec.com/nvd/cve-2025-65431)\nAn issue was discovered in allauth-django before 65.13.0. Both Okta and NetIQ were using preferred_username as the identifier for third-party provider accounts. That value may be mutable and should therefore be avoided for authorization decisions. The providers are now using sub instead.",
